---
import Base from "../../layouts/Base.astro";
import { chapters } from "../../lib/srd";
const caps = chapters();
---

<Base title="El libro">
  <p class="entradilla">Los 16 capítulos del SRD, en el mismo orden que el PDF.</p>
  <ol class="capitulos">
    {caps.map((c) => (
      <li>
        <a href={`/libro/${c.slug}/`}>{c.title}</a> <span class="pag">p{c.page}</span>
      </li>
    ))}
  </ol>
</Base>
